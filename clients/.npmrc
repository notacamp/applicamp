# @notacamp/ui comes from GitHub Packages, which wants a token even for public
# packages: NODE_AUTH_TOKEN from the environment (`gh auth token` locally; the
# job's GITHUB_TOKEN with `packages: read` in CI; a BuildKit secret in the
# image build). Never write a token here.
@notacamp:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
