# Copy to `.env` and edit. Never commit the real file.

# --- Required -----------------------------------------------------------------
# URL-safe characters only (it is embedded in a connection URL), e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The URL people reach this instance at: unsafe requests must come from its
# origin, and the sign-in callbacks are under it
# (<APPLICAMP_PUBLIC_URL>/bff/callback/campbooks and .../linkedin).
APPLICAMP_PUBLIC_URL=http://localhost:8080

# --- Sign-in (at least one provider) -------------------------------------------
# A provider with no client id is not offered. Client secrets are files in
# deploy/secrets/ (mounted at /run/secrets/applicamp).
#
# Sign in with Campbooks: register Applicamp as an OAuth app on your Campbooks
# instance, with the callback above.
# APPLICAMP_OIDC__CAMPBOOKS__ISSUER=https://campbooks.example.com
# APPLICAMP_OIDC__CAMPBOOKS__CLIENT_ID=
# APPLICAMP_OIDC__CAMPBOOKS__CLIENT_SECRET_FILE=/run/secrets/applicamp/campbooks-client-secret
#
# Sign in with LinkedIn: an app with the "Sign In with LinkedIn using OpenID
# Connect" product, with the callback above.
# APPLICAMP_OIDC__LINKEDIN__CLIENT_ID=
# APPLICAMP_OIDC__LINKEDIN__CLIENT_SECRET_FILE=/run/secrets/applicamp/linkedin-client-secret
# Only to point LinkedIn sign-in at a fake provider (tests):
# APPLICAMP_OIDC__LINKEDIN__ISSUER=https://www.linkedin.com/oauth

# --- AI (optional) --------------------------------------------------------------
# The `complete` model reads a PDF or pasted text into a profile draft. Any
# OpenAI-compatible API: OpenRouter, or a self-hosted vLLM / llama.cpp /
# Ollama. Unset, profile imports take only the LinkedIn data export ZIP.
# The base URL includes the version prefix; the key is a file in
# deploy/secrets/.
# APPLICAMP_AI__COMPLETE__BASE_URL=https://openrouter.ai/api/v1
# APPLICAMP_AI__COMPLETE__MODEL=
# APPLICAMP_AI__COMPLETE__API_KEY_FILE=/run/secrets/applicamp/ai-complete-api-key
# Tokens (in + out) one account may use per UTC day; 0 for no cap.
# APPLICAMP_AI__DAILY_TOKENS=200000

# --- Optional -----------------------------------------------------------------
# Host port for the server (the container listens on 8080).
APPLICAMP_PORT=8080
# json (default) or pretty
APPLICAMP_LOG_FORMAT=json
# Apply database migrations on startup (default true).
APPLICAMP_RUN_MIGRATIONS=true
# APPLICAMP_DATABASE_MAX_CONNECTIONS=10
# RUST_LOG=info
# The image serves the web client from /app/web; unset to serve only the API.
# APPLICAMP_WEB_DIR=/app/web
# Another image tag than :main, e.g. a main-<sha> one.
# APPLICAMP_IMAGE=ghcr.io/notacamp/applicamp:main
