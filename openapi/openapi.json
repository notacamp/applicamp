        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            },
            "description": "In the order the sign-in page shows them."
          }
        }
      },
      "Skill": {
        "type": "object",
        "description": "A skill.",
        "required": [
          "name"
        ],
        "properties": {
          "level": {
            "type": [
              "string",
              "null"
            ],
            "description": "How well, in their words."
          },
          "name": {
            "type": "string",
            "description": "The skill (\"PostgreSQL\")."
          }
        },
        "additionalProperties": false
      },
      "Work": {
        "type": "object",
        "description": "A position.",
        "required": [
          "highlights"
        ],
        "properties": {
          "endDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "As `startDate`; none while it is their current position."
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Achievements, one sentence each."
          },
          "location": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "The company."
          },
          "position": {
            "type": [
              "string",
              "null"
            ],
            "description": "The title."
          },
          "startDate": {
            "type": [
              "string",
              "null"
            ],
            "description": "`YYYY`, `YYYY-MM` or `YYYY-MM-DD`."
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "What they did."
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-applicamp_session",
        "description": "The web app's session cookie, set by `/bff/callback/{provider}` (`HttpOnly`, `Secure`, `SameSite=Strict`; named `applicamp_session` when the instance's public URL is plain http). Unsafe methods also need the `X-Applicamp-CSRF: 1` header and the app's own `Origin`."
      }
    }
